##### TMUX Configuration File ####################################
set-option -sa terminal-overrides ",xterm*:Tc"

# Pass extended key-reporting (Kitty keyboard protocol / CSI u, enabled in
# iTerm2's profile settings) through to whatever's running in the pane
# instead of decoding it down to tmux's own simpler key events — otherwise
# a program inside tmux (nvim) never sees the richer encoding that lets it
# tell e.g. Cmd+h apart from other combinations sharing the same legacy
# byte sequence.
set -g extended-keys always

##### Prefix #####################################################

# Replace the default Ctrl-b prefix with Ctrl-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Reload config with Prefix + r
bind r source-file ~/.tmux.conf \; display-message "tmux config reloaded"


##### General behaviour ##########################################

# Faster response when using Escape-heavy tools such as Neovim
set -sg escape-time 10

# Keep plenty of terminal history
set -g history-limit 100000

# Enable mouse scrolling, pane selection, and resizing
set -g mouse on

# Pass terminal focus events to applications such as Neovim
set -g focus-events on

# Use vi-style keys in copy mode
setw -g mode-keys vi


##### Windows ####################################################

# Number windows and panes from 1
set -g base-index 1
setw -g pane-base-index 1

# Remove numbering gaps after closing windows
set -g renumber-windows on

# Create new windows in the current pane's directory
unbind c
bind c new-window -c "#{pane_current_path}"

# Alt+Shift arrow to switch windows
# (plain Shift+Arrow is reserved in case an editor ever binds it for
# text selection - Alt+Shift avoids relying on that staying unclaimed)
bind -n M-S-Left  previous-window
bind -n M-S-Right next-window

# Vim-style alternative to the above
bind -n M-h previous-window
bind -n M-l next-window

# Alternative window navigation
bind -r p previous-window
bind -r n next-window


##### Panes ######################################################

# Replace the default split bindings
unbind '"'
unbind %

# Split left/right with Prefix + |
bind | split-window -h -c "#{pane_current_path}"

# Split top/bottom with Prefix + -
bind - split-window -v -c "#{pane_current_path}"

# Navigate panes with Prefix + h/j/k/l
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Navigate panes with Ctrl + Shift + arrow, without the prefix
bind -n C-S-Left  select-pane -L
bind -n C-S-Right select-pane -R
bind -n C-S-Up    select-pane -U
bind -n C-S-Down  select-pane -D

# Ctrl+h/j/k/l pane crossing itself doesn't need anything here: the
# christoomey/vim-tmux-navigator plugin is installed on *both* sides —
# nvim's own plugin (loaded via lazy.nvim) and this tmux-side counterpart
# (TPM, `@plugin 'christoomey/vim-tmux-navigator'` below), which registers
# its own equivalent `is_vim`-gated bindings for these same keys when TPM
# loads at the bottom of this file, after this point — so anything bound
# here would just be silently overridden by the plugin's own (a version
# that also recognises fzf panes, which a hand-rolled one here wouldn't).

# Resize panes with Prefix + Shift-h/j/k/l
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Resize panes with Option + arrow, without the prefix
bind -n M-Left  resize-pane -L 2
bind -n M-Right resize-pane -R 2
bind -n M-Up    resize-pane -U 1
bind -n M-Down  resize-pane -D 1

# Toggle the current pane between normal and fullscreen
bind z resize-pane -Z

# Show pane numbers for quick selection
bind q display-panes

# Clear the screen and scrollback of the current pane only
# (Caps Lock (Hyper) + K, remapped to F13 by Karabiner so it's terminal-agnostic;
# terminals encode F13 as the legacy VT220 sequence for Shift+F1)
bind -n S-F1 send-keys 'C-l' \; clear-history

# Toggle broadcasting keystrokes to every pane in the current window
bind S setw synchronize-panes \; display-message "synchronize-panes #{?pane_synchronized,on,off}"

# Clear and re-run each pane's own setup command in one shot. Sync mode
# broadcasts the same literal keystrokes to every pane, but each pane's
# shell expands $PANE_SETUP against its own environment, so per-pane
# scripts set via `export PANE_SETUP=./setup-frontend.sh` (etc.) still
# run correctly even though the command text sent is identical. Panes
# that never set PANE_SETUP just clear and stay idle, no error (the
# ${PANE_SETUP:-} default also keeps this safe under `set -u`).
bind R setw synchronize-panes on \; send-keys 'clear; [ -n "${PANE_SETUP:-}" ] && eval "$PANE_SETUP"' Enter \; setw synchronize-panes off


##### Copy mode and clipboard ####################################

# Allow tmux to use the terminal clipboard when supported
set -s set-clipboard on


# Send tmux copies to the macOS clipboard
set -s copy-command "pbcopy"


# Vim-style selection controls
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi V send-keys -X select-line
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel

# Mouse drag selection copies to the configured clipboard
bind -T copy-mode-vi MouseDragEnd1Pane \
    send-keys -X copy-pipe-and-cancel


##### Status bar #################################################

set -g status on
set -g status-position top
set -g status-interval 5

# Session name on the left
set -g status-left-length 30
set -g status-left ' [#S] '

# Prefix state, CPU, battery, hostname, date, and time
set -g status-right-length 120
set -g status-right \
    '#{prefix_highlight} | CPU #{cpu_percentage} | #{battery_percentage} | #H | %a %d %b %H:%M '

# Keep window names visible
setw -g automatic-rename on

# Update the terminal window title
set -g set-titles on
set -g set-titles-string '#S:#I.#P #W'


##### Messages ###################################################

# Leave tmux messages visible slightly longer
set -g display-time 2000

# Keep pane-number overlays visible slightly longer
set -g display-panes-time 1500


##### Popups #####################################################

# Popups host fzf (fzf-tab completion, sessionx). Rather than have both
# tmux and fzf draw a frame, tmux owns the border everywhere and fzf runs
# borderless inside it — see dot_config/zsh/env/fzf-tab.zsh. Keeping the
# border here (instead of disabling it globally) means popups that aren't
# fzf still get a frame.
set -g popup-border-lines rounded

# Match fzf's own border colour (--color=border:#665c54 in common.zsh) so a
# tmux-drawn frame is indistinguishable from an fzf-drawn one.
set -g popup-border-style 'fg=#665c54'

# Inherit the terminal background rather than painting a solid panel, to
# match the transparent status bar.
set -g popup-style 'bg=default'


##### Plugins ####################################################

# Plugin manager
set -g @plugin 'tmux-plugins/tpm'

# Gruvbox Dark Hard theme
set -g @plugin 'Adams-Galaxy/gruvbox-tmux'
set -g @gruvbox_flavour 'dark-hard'
set -g @gruvbox_host 'on'
set -g @gruvbox_date_time '%I:%M %p'
set -g @gruvbox_prefix 'on'
set -g @gruvbox_cpu 'on'
set -g @gruvbox_battery 'on'

# Nerd Font battery charge tiers
set -g @batt_icon_charge_tier1 '󰁺'
set -g @batt_icon_charge_tier2 '󰁻'
set -g @batt_icon_charge_tier3 '󰁼'
set -g @batt_icon_charge_tier4 '󰁽'
set -g @batt_icon_charge_tier5 '󰁾'
set -g @batt_icon_charge_tier6 '󰁿'
set -g @batt_icon_charge_tier7 '󰂀'
set -g @batt_icon_charge_tier8 '󰁹'

# Preserve workspaces across restarts
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Seamless navigation between Neovim splits and tmux panes
set -g @plugin 'christoomey/vim-tmux-navigator'

# CPU and battery information
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-battery'

# Color scheme and copy to system clipboard
set -g @plugin 'tmux-plugins/tmux-yank'

# Sensible defaults for tmux
set -g @plugin 'tmux-plugins/tmux-sensible'

# Prefix, copy-mode, and synchronized-pane indicators
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'

set -g @prefix_highlight_show_copy_mode 'on'
set -g @prefix_highlight_show_sync_mode 'on'
set -g @prefix_highlight_fg '#ebdbb2'
set -g @prefix_highlight_bg '#d65d0e'
set -g @prefix_highlight_copy_mode_attr 'fg=#fabd2f,bg=#d65d0e,bold'
set -g @prefix_highlight_sync_mode_attr 'fg=#b8bb26,bg=#d65d0e,bold'
set -g @prefix_highlight_output_prefix ' '
set -g @prefix_highlight_output_suffix ' '

# Session management
set -g @plugin 'omerxx/tmux-sessionx'
set -g @sessionx-fzf-builtin-tmux 'on'
# Defaults to Shift-O; lowercase is easier to hit alongside the rest of
# the prefix bindings.
set -g @sessionx-bind 'o'

# Automatically save and restore tmux sessions
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

# TPM must remain at the bottom
run '~/.tmux/plugins/tpm/tpm'
