# tinty's own config - https://github.com/tinted-theming/tinty
#
# Only covers the tools with an official tinted-theming template that
# tinty can generate directly, AND that we actually want tinty driving -
# currently just yazi plus tinted-shell (ANSI shell colors +
# $BASE16_COLOR_*_HEX exports). Each [[items]] entry below is a deliberate
# opt-in per tool, not "every tool tinty supports" - fzf had one here
# and was removed: tinted-fzf's own tinted8 mustache template emits
# invalid empty-hex color specs (border:#, prompt:#, ...) for every
# tinted8 scheme, breaking fzf outright, and separately the color scheme
# itself was preferred to stay exactly as hand-tuned pre-migration
# (dot_config/zsh/env/common.zsh.tmpl's hardcoded FZF_DEFAULT_OPTS) -
# not tinty-managed at all. nvim was never wired up here either - its
# config has no tinty/theming reference, untouched by any of this.
# tmux is deliberately NOT an item here - tinted-tmux's own README
# recommends installing it as a normal TPM plugin instead
# (dot_tmux.conf.tmpl), since reloading tmux's color needs a running
# server (`tmux source-file`), which doesn't fit tinty's apply-time hook
# model as cleanly as a plugin that tmux itself manages.
# wezterm/starship/fastfetch have no official template at all - they
# read colors from .chezmoidata/theming.yaml instead (kept in sync with
# whatever's applied here by the global hook below).
shell = "sh -c '{}'"

# What `tinty init` (run_once_after_setup_tinty.sh.tmpl, and tinty.zsh's
# shell integration on every new shell) falls back to applying when
# there's no prior "last applied" state yet - i.e. a fresh machine.
# Matches this machine's own chezmoi `theme` data value (already the full
# scheme id, e.g. "tinted8-gruvbox-dark" - NOT prefixed here, unlike an
# earlier version of this file, since a bare slug is ambiguous between
# systems), so a first-time `chezmoi apply` and a first-time `tinty init`
# agree on the same theme without anything needing to apply one
# explicitly.
default-scheme = "{{ .theme }}"

# Refreshes .chezmoidata/theming.yaml with the palette just applied and
# points this machine's chezmoi config at it as the active theme - see
# scripts/tinty-sync.sh for what it actually does, and why it stops
# short of running `chezmoi apply` itself.
hooks = ["sh '{{ .chezmoi.sourceDir }}/scripts/tinty-sync.sh'"]

[[items]]
name = "tinted-shell"
path = "https://github.com/tinted-theming/tinted-shell"
hook = ". %f"
supported-systems = ["base16", "base24", "tinted8"]
themes-dir = "scripts"

# yazi doesn't read from tinty's own data dir - its theme.toml
# ([flavor] dark = "tinted-scheme", dot_config/yazi/theme.toml) points at
# a fixed flavor directory under yazi's own config, so the hook copies
# the freshly generated flavor there on every apply instead of sourcing
# anything. mkdir -p first since a fresh machine won't have the flavor
# directory yet.
#
# base16 only, unlike the two items above - tinted-yazi's own repo has no
# base24 or tinted8 flavors at all (checked: only base16/*.toml exist
# under flavors/). Applying a base24 or tinted8 scheme leaves yazi on
# whatever base16 scheme it last had - stale rather than broken, tinty
# simply skips an item once the applied scheme's system isn't in its
# supported-systems.
[[items]]
name = "tinted-yazi"
path = "https://github.com/tinted-theming/tinted-yazi"
hook = '''mkdir -p "$HOME/.config/yazi/flavors/tinted-scheme.yazi" && cp -f "$TINTY_THEME_FILE_PATH" "$HOME/.config/yazi/flavors/tinted-scheme.yazi/flavor.toml"'''
supported-systems = ["base16"]
themes-dir = "flavors"
