{{- /* Target: ~/.config/zsh/.zshrc */ -}}

export ZSH="$HOME/.oh-my-zsh"
export DOTFILES="$HOME/.config/zsh"

# Shared config
source "$DOTFILES/env/common.zsh"
source "$DOTFILES/env/path.zsh"
source "$DOTFILES/env/completion.zsh"
source "$DOTFILES/env/functions.zsh"
source "$DOTFILES/env/aliases.zsh"
source "$DOTFILES/env/projects.zsh"
source "$DOTFILES/env/prompt.zsh"
source "$DOTFILES/env/splash.zsh"

# OS-specific config
case "$(uname -s)" in
  Darwin)
    source "$DOTFILES/os/macos.zsh"
    ;;
  Linux)
    source "$DOTFILES/os/linux.zsh"
    ;;
esac

# Optional local overrides
if [[ -f "$DOTFILES/local/local.zsh" ]]; then
  source "$DOTFILES/local/local.zsh"
fi
