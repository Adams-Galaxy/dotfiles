{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/Users/adamwilliams/dev/ascii-art/examples/icon.txt",
    "padding": {
      "left": 2
    }
  },
  // Named ANSI colors, not hex — these resolve through the terminal's own
  // palette (WezTerm's `brights` table in config/appearance.lua is already
  // gruvbox), so there's one source of truth for the theme instead of a
  // second hardcoded copy here. Only backs title/separator now — every
  // boxed module below sets its own keyColor, walking orange -> yellow ->
  // cyan -> blue down the four sections. Orange is the one exception: it's
  // not in fastfetch's named-color set (only the 8 base ANSI names resolve
  // through the terminal palette), so it's hand-set hex on each
  // Hardware-section module below rather than a named color.
  "display": {
    // Truncation (see the `:-N` format modifiers below) already keeps
    // known-variable fields short; this is the backstop for anything
    // that still overflows — stops the terminal wrapping it onto a
    // second line instead of letting it run off the edge.
    "disableLinewrap": true,
    "color": {
      "title": "bright_cyan",
      "keys": "bright_yellow"
    }
  },
  "modules": [
    "title",
    "separator",

    { "type": "custom", "format": "\u001b[90m╭──────────────────────Hardware──────────────────────╮" },
    { "type": "host", "key": "󰌢  PC", "keyColor": "#fe8019" },
    // fastfetch's own format syntax supports truncation:
    // `{placeholder:-N}` caps a field at N chars and appends "…" if it
    // was cut — real truncation, not the linewrap-suppression
    // `disableLinewrap` gives (that just stops the terminal from
    // wrapping; overflow content still overwrites itself instead of
    // being cut). Applied here to `name`, the one variable-length field
    // in each of these — cores/frequency are always a couple of short
    // digits, no realistic overflow risk to guard there.
    { "type": "cpu", "key": "│ ├󰻠 ", "keyColor": "#fe8019", "format": "{name:-32} ({core-types}) @ {freq-max}" },
    { "type": "gpu", "key": "│ ├󰍹 ", "keyColor": "#fe8019", "format": "{name:-32} ({core-count}) @ {frequency} [{type}]" },
    { "type": "memory", "key": "│ ├󰑭 ", "keyColor": "#fe8019" },
    // {size-percentage} already includes its own "%" — a literal one
    // after it doubles up ("69%%"), so there isn't one here.
    { "type": "disk", "key": "└ └󰋊 ", "keyColor": "#fe8019", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "custom", "format": "\u001b[90m╰────────────────────────────────────────────────────╯" },
    "break",

    { "type": "custom", "format": "\u001b[90m╭──────────────────────Software──────────────────────╮" },
    { "type": "os", "key": "  OS", "keyColor": "yellow" },
    { "type": "kernel", "key": "│ ├󰌽 ", "keyColor": "yellow" },
    { "type": "packages", "key": "│ ├󰏗 ", "keyColor": "yellow" },
    { "type": "shell", "key": "└ └󰞷 ", "keyColor": "yellow" },
    { "type": "custom", "format": "\u001b[90m╰────────────────────────────────────────────────────╯" },
    "break",

    { "type": "custom", "format": "\u001b[90m╭──────────────────────Desktop───────────────────────╮" },
    { "type": "de", "key": "󰧨  DE", "keyColor": "cyan" },
    // display/icons/terminalfont don't have a clean matching glyph in this
    // icon set (unlike fancy.jsonc's lm/wm/wmtheme) — plain tree connector
    // rather than guessing at an unverified codepoint that could render as
    // a tofu box.
    // Default display format runs long enough to wrap at 80 columns
    // (scale factor + physical inches + a "[Built-in]" tag nobody needs on
    // a laptop with exactly one screen) — kept short here too.
    { "type": "display", "key": "│ ├ ", "keyColor": "cyan", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "icons", "key": "│ ├ ", "keyColor": "cyan" },
    { "type": "terminalfont", "key": "│ ├ ", "keyColor": "cyan" },
    // {pretty-name} is fastfetch's own cleaned-up display name (e.g.
    // "WezTerm") — default format also tacks on a version nobody reads.
    // Truncated too: over SSH this can end up naming a remote multiplexer
    // chain rather than one short local app name.
    { "type": "terminal", "key": "└ └󰆍 ", "keyColor": "cyan", "format": "{pretty-name:-24}" },
    { "type": "custom", "format": "\u001b[90m╰────────────────────────────────────────────────────╯" },
    "break",

    { "type": "custom", "format": "\u001b[90m╭───────────────────────Extras───────────────────────╮" },
    { "type": "uptime", "key": "  \u203a  Uptime  ", "keyColor": "blue" },
    { "type": "swap", "key": "  \u203a  Swap  ", "keyColor": "blue" },
    { "type": "localip", "key": "  \u203a  Local IP  ", "keyColor": "blue" },
    // Battery's default *key* (not format) appends the battery's model/
    // chip identifier in parentheses — not human-readable info, closer to
    // noise. The key override above drops that; format keeps just the
    // numbers that are actually useful day to day.
    { "type": "battery", "key": "  \u203a  Battery  ", "keyColor": "blue", "format": "{capacity} ({time-hours}h {time-minutes}m remaining) [{status}]" },
    { "type": "poweradapter", "key": "  \u203a  Power  ", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[90m╰────────────────────────────────────────────────────╯" },
    "break",

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
