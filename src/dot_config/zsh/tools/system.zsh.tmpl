# Small system-inspection and utility workflows.

envn() { env | cut -d= -f1 | sort }
cols() { tput cols }
rows() { tput lines }
tsize() { print "$(cols) $(rows)" }

{{#if features.mufetch}}
# Mufetch is installed and supported only on the macOS configuration.
song() {
  if command -v mufetch >/dev/null 2>&1; then
    mufetch search "$@"
  else
    print -u2 "mufetch is not installed"
    return 127
  fi
}
{{/if}}

# Adjacent to cd, used to tunnel down into a new directory.
vf() {
  if [[ -d "$1" ]]; then
    cd "$1" || return 0
  else
    mkdir -p "$1" && cd "$1" || return 0
  fi
}
