# Small system-inspection and utility workflows.

envn() { env | cut -d= -f1 | sort }
cols() { tput cols }
rows() { tput lines }
tsize() { print "$(cols) $(rows)" }

{{#if features.mufetch}}
# Mufetch is installed and supported only on the macOS configuration.
song() {
  if has_command mufetch; then
    mufetch search "$@"
  else
    print -u2 "mufetch is not installed"
    return 127
  fi
}
{{/if}}
