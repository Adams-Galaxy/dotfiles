# Clipboard access with a backend selected during Wombat construction.

{{#if clipboard.macos}}
_clip_read() { pbpaste }
_clip_write() { pbcopy }
{{/if}}
{{#if clipboard.wayland}}
_clip_read() { wl-paste --no-newline }
_clip_write() { wl-copy }
{{/if}}
{{#if clipboard.x11}}
_clip_read() { xclip -selection clipboard -o }
_clip_write() { xclip -selection clipboard }
{{/if}}
{{#if clipboard.wsl}}
_clip_read() {
  powershell.exe -NoProfile -NonInteractive -Command \
    '$OutputEncoding = [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false); [Console]::Write((Get-Clipboard -Raw))'
}
_clip_write() { clip.exe }
{{/if}}

clip() {
  emulate -L zsh

  local target="clipboard"
  local value

  if [[ "$1" == "--env" ]]; then
    shift
    if (( $# == 0 )); then
      print -u2 "Usage: clip --env VARIABLE [TEXT ...]"
      return 2
    fi
    target="$1"
    shift

    if [[ -z "$target" || ! "$target" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      print -u2 "Usage: clip --env VARIABLE [TEXT ...]"
      return 2
    fi
  elif [[ "$1" == "--" ]]; then
    shift
  elif [[ "$1" == "--help" ]]; then
    print "Usage: clip [TEXT ...]"
    print "       clip --env VARIABLE [TEXT ...]"
    return 0
  fi

  if (( $# > 0 )) && [[ ! -t 0 ]]; then
    print -u2 "clip accepts either arguments or piped input, not both"
    return 2
  fi

  if [[ "$target" != "clipboard" ]]; then
    if (( $# > 0 )); then
      value="$*"
    elif [[ ! -t 0 ]]; then
      value="$(cat)"
    else
      print -r -- "${(P)target-}"
      return 0
    fi

    if (( ZSH_SUBSHELL > 0 )); then
      print -u2 "clip --env cannot update the parent shell when piped onward"
      return 2
    fi

    export "$target=$value"
    print -r -- "$value"
    return 0
  fi

  if (( $# > 0 )); then
    print -rn -- "$*" | _clip_write
  elif [[ ! -t 0 ]]; then
    _clip_write
  else
    _clip_read
    return
  fi

  _clip_read
}
