# Wombat-managed interactive Zsh startup.
#
# The order below is intentional: completion functions must enter fpath before
# compinit, and fzf-tab must attach after compinit but before later ZLE wrappers.

[[ -n "${ZSHRC_LOADED:-}" ]] && export ZSHRC_RELOADED=1
export DOTFILES="$HOME/.config/zsh"

source "$DOTFILES/core/environment.zsh"
source "$DOTFILES/core/path.zsh"
source "$DOTFILES/core/aliases.zsh"

case "$(uname -s)" in
  Darwin) source "$DOTFILES/platform/macos.zsh" ;;
  Linux) source "$DOTFILES/platform/linux.zsh" ;;
esac

source "$DOTFILES/tools/editor.zsh"
source "$DOTFILES/tools/python.zsh"
source "$DOTFILES/tools/yazi.zsh"
source "$DOTFILES/tools/system.zsh"
source "$DOTFILES/tools/clipboard.zsh"
source "$DOTFILES/tools/tmux.zsh"
source "$DOTFILES/tools/dotfiles.zsh"
source "$DOTFILES/tools/fuzzy/files.zsh"
source "$DOTFILES/tools/fuzzy/search.zsh"
source "$DOTFILES/tools/fuzzy/git.zsh"
source "$DOTFILES/tools/fuzzy/system.zsh"
source "$DOTFILES/tools/fuzzy/project.zsh"

source "$DOTFILES/completion/setup.zsh"
source "$DOTFILES/plugins/loader.zsh"
load_zsh_plugin_bundle "$DOTFILES/plugins/pre.txt" "$ZSH_CACHE_DIR/zsh_plugins.pre.zsh"
source "$DOTFILES/completion/compinit.zsh"
load_zsh_plugin_bundle "$DOTFILES/plugins/post.txt" "$ZSH_CACHE_DIR/zsh_plugins.zsh"
unfunction load_zsh_plugin_bundle
source "$DOTFILES/completion/fzf-tab.zsh"

# External tools attach after completion infrastructure is ready. Generated
# completion hooks belong here because they are tool lifecycle code, not Zsh's
# static completion policy.
source "$DOTFILES/init/cache.zsh"
source "$DOTFILES/init/integrations.zsh"
source "$DOTFILES/init/completions.zsh"

source "$DOTFILES/ui/diagnostics.zsh"
source "$DOTFILES/ui/splash.zsh"

# Local state stays outside Wombat so machine-specific settings never enter
# the deployed source tree. It loads last and may deliberately override defaults.
[[ -r "$DOTFILES/local.zsh" ]] && source "$DOTFILES/local.zsh"

if [[ -o interactive ]] && ! splash_should_skip; then
  clear
  splash
fi

export ZSHRC_LOADED=1
